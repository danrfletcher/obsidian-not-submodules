{
	"name": "not-submodules",
	"version": "1.0.3",
	"description": "Replace git submodules with plain nested git repos, ignored via .gitignore and tracked via folder-note frontmatter.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "tsx --test \"src/**/*.test.ts\""
	},
	"keywords": [],
	"author": "Dan Fletcher",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"esbuild": "0.21.5",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"tsx": "^4.23.15",
		"typescript": "4.7.4"
	}
}
